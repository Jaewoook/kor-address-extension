{
  "compilerOptions": {
    "composite": true,
    "allowJs": true,
    "skipLibCheck": true,
    "useDefineForClassFields": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "module": "ESNext",
    "target": "ES2020",
    "noEmit": true,
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "paths": {
      "@popup/*": ["apps/popup/*"],
      "@options/*": ["apps/options/*"],
      "@shared/*": ["shared/*"]
    },
    "strict": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["apps", "shared", "tests", "vite-env.d.ts"]
}
